      "question": "If an int element requires 2-byte memory, How many bytes will be allocated to int arr[5][5]?",
      "options": {
        "A": "5",
        "B": "50",
        "C": "25",
        "D": "10"
      },
      "correct": "B",
      "explanation": "int arr[5][5] holds 5 × 5 = 25 elements, and with 2 bytes per int the whole array needs 25 × 2 = 50 bytes of contiguous memory.",
      "topicQuality": "specific"
    },
