      ],
      "question": "Which function places an element on the stack?",
      "options": {
        "A": "Pop",
        "B": "Push",
        "C": "Peek",
        "D": "isEmpty"
      },
      "correct": "B",
      "explanation": "push inserts an element on top and advances the top index. pop removes, peek only reads, and isEmpty tests the state without changing it.",
      "topicQuality": "specific"
