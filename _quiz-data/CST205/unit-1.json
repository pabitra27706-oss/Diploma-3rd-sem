      ],
      "question": "If TOP = MAX-1, then the stack is -",
      "options": {
        "A": "full",
        "B": "empty",
        "C": "contains some data",
        "D": "none of these"
      },
      "correct": "A",
      "explanation": "With top sitting at MAX-1 the array has no free slot, so another push would overflow. That state is called a full stack.",
      "topicQuality": "specific"
    },
    {
      "id": "CST205-U1-Q005",
