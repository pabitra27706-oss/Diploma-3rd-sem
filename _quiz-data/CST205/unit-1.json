      ],
      "question": "The number of elements that can be removed from the stack at any time is -",
      "options": {
        "A": "3",
        "B": "4",
        "C": "1",
        "D": "0"
      },
      "correct": "C",
      "explanation": "Only the top element is reachable at any moment, so a single pop removes exactly one element. Any deeper element needs the ones above it removed first.",
      "topicQuality": "specific"
    },
    {
      "id": "CST205-U1-Q004",
