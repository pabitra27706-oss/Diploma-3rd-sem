      ],
      "question": "Insertion in stack is done in -",
      "options": {
        "A": "front",
        "B": "rear",
        "C": "top",
        "D": "bottom"
      },
      "correct": "C",
      "explanation": "A stack is LIFO, so both insertion (push) and deletion (pop) happen at the top end. Front and rear belong to a queue, and a stack offers no access at the bottom.",
      "topicQuality": "specific"
    },
    {
      "id": "CST205-U1-Q002",
      "type": "mcq",
      "topic": "Stack Operations",
      "difficulty": "easy",
