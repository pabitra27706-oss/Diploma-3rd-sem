      ],
      "question": "Pushing an element into a stack already having five elements and a stack size of 5, then the stack becomes -",
      "options": {
        "A": "Overflow",
        "B": "Crash",
        "C": "Underflow",
        "D": "User flow"
      },
      "correct": "A",
      "explanation": "Five elements in a stack of size 5 means top = MAX-1, so pushing once more overflows. Nothing is stored and the operation must be rejected.",
      "topicQuality": "specific"
    },
    {
      "id": "CST205-U1-Q006",
      "type": "mcq",
