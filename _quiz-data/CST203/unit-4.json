      "id": "CST203-U4-Q001",
      "type": "mcq",
      "topic": "File Opening Modes",
      "difficulty": "medium",
      "marks": 1,
      "year": 2024,
      "source": "PYQ",
      "tags": [
        "file",
        "open",
        "read-mode"
      ],
      "question": "Which of the following command is used to open a file \"c:\\temp.txt\" in read-mode only?",
      "options": {
        "A": "infile = open(\"c:\\temp.txt\",\"r\")",
        "B": "infile = open(\"c:\\temp.txt\",\"r\")",
        "C": "infile = open(file=\"c:\\temp.txt\",\"r+\")",
        "D": "infile = open(file=\"c:\\temp.txt\",\"r+\")"
      },
      "correct": "A",
      "explanation": "open() takes the file name and a mode string, and \"r\" means read-only (it is also the default). \"r+\" would allow writing as well, so the plain r call (option A) is the read-only one.",
      "topicQuality": "specific"
    },
